// Tight fastfetch config (fastfetch 2.71). No logo, no title, no colour row, no network lookups.
// Disable the auto-run in ~/.zshrc / fish by removing the `fastfetch` line there; run `fastfetch` manually any time.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": "  ",
        "color": { "keys": "blue" },
        "brightColor": false,   // no bold/bright keys
        "size": { "binaryPrefix": "iec", "ndigits": 1 },
        "percent": { "type": 1 }
    },
    "modules": [
        { "type": "kernel",   "key": "Kernel ", "format": "{release}" },
        { "type": "uptime",   "key": "Uptime " },
        { "type": "shell",    "key": "Shell  ", "format": "{pretty-name} {version}" },
        { "type": "de",       "key": "Desktop", "format": "{pretty-name} {version}" },
        { "type": "cpu",      "key": "CPU    ", "format": "{name}" },
        { "type": "gpu",      "key": "GPU    ", "format": "{name} · v{driver~21}", "hideType": "integrated" },  // {driver} is "nvidia (open source) X"; ~21 skips that 21-char label
        { "type": "memory",   "key": "RAM    " },
        { "type": "disk",     "key": "Disk   ", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage}) {filesystem}" },
        "break"  // blank line before the prompt
    ]
}
